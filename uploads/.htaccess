# Allow access to uploaded files
Options -Indexes

# Disable PHP processing for media files (ensures Apache serves them directly with Content-Length)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|mp3|wav|ogg|m4a)$">
    # Remove PHP handler for these files
    RemoveHandler .jpg .jpeg .png .gif .webp .mp3 .wav .ogg .m4a
    SetHandler default-handler
    
    # Allow access
    Order Allow,Deny
    Allow from all
    
    # Set proper headers for file serving
    <IfModule mod_headers.c>
        Header set Accept-Ranges "bytes"
        Header set Cache-Control "public, max-age=31536000"
        # Force Content-Length (Apache should send this automatically, but ensure it)
        Header unset Content-Length
    </IfModule>
</FilesMatch>

# Set MIME types
<IfModule mod_mime.c>
    AddType image/jpeg .jpg .jpeg
    AddType image/png .png
    AddType image/gif .gif
    AddType image/webp .webp
    AddType audio/mpeg .mp3
    AddType audio/wav .wav
    AddType audio/ogg .ogg
    AddType audio/mp4 .m4a
</IfModule>
