# Uploads folder - user uploaded files
uploads/

# Config folder - sensitive configuration files
config/
# But allow config template and documentation files
!config/*.example
!config/*.template
!config/README.md

# Specifically ignore database.php (even if config/ is already ignored)
config/database.php

# Environment files
.env
.env.local
.env.*.local

# Composer
/vendor/
composer.lock

# Node modules (if using npm)
node_modules/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/

# OS files
Thumbs.db
.DS_Store
